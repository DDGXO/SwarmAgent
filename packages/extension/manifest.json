{
  "manifest_version": 3,
  "name": "CursorWeb Live Agent",
  "version": "0.1.0",
  "description": "Auto-inject CursorWeb client for live AI multi-agent editing without touching source code.",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
